# Copy to .env (next to run_gui.py, or next to DS3Library.exe). Everything is optional.
# Database: leave out for a local SQLite file (data/material_library.db); PostgreSQL example below.
#DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/material_library
# Folder whose files become libraries at start-up (default: data/libraries). Set AUTO_IMPORT=0 to switch it off.
#AUTO_IMPORT_DIR=D:\data\libraries
#AUTO_IMPORT=1
